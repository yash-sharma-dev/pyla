# Copy this file to .env and fill in your values.
# Never commit .env — it is gitignored.

# ── Supabase (cloud-only, no local Supabase container needed) ──────────────
# Used by the browser extension and MCP server (VITE_ prefix)
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-public-key>

# Used by the Next.js web dashboard (NEXT_PUBLIC_ prefix, same values)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-public-key>

# ── Pyla API Key ────────────────────────────────────────────────────────────
# Generate this from your Pyla dashboard — required by the MCP server.
PYLA_API_KEY=<your-pyla-api-key>
